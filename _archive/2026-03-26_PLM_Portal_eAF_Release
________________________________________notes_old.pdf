            </script>
    <div id="header"> <img src="/files/logo_emea.jpg" alt="EMEA logo" class="logo"><span><a href="/" title="European Medicines Agency logo with link to homepage">EMEA: European Medicines Agency <span>- Science, medicines, health</span></a></span>
      <div class="headerContent">
        <p class="eu"> An Agency of the European Union<a href="http://europa.eu/"><img height="35" width="53" alt="EU flag" src="/files/eu_flag.gif"></a> </p>
