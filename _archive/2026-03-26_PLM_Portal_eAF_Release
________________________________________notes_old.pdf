<style type="text/css">


#content-wrap .centre-col {
    float: left;
    width: 743px;
    word-wrap: break-word;
}

.content-header {
    background: url(/files/bg_content_header.gif) repeat-x scroll left top transparent;
    float: left;
    margin-bottom: 12px;
    overflow: hidden;
    position: relative;
    width: 994px;
    z-index: 1;
}

.content-header div {
    border: 1px solid #D9D9D9;
    overflow: hidden;
    width: 992px;
}

.content-header h2 {
    color: #333333;
    float: none;
    font-size: 1.7em;
    font-weight: normal;
    line-height: 1.2em;
    margin: 0;
    padding: 7px 0 7px 15px;
    width: 519px;
    word-wrap: break-word;
}

.in-focus {
    background: url(/files/bg_grad_grey.gif) repeat-x scroll left bottom transparent;
    border: 1px solid #D9D9D9;
    clear: left;
    margin: 0 0 10px;
    overflow: auto;
    padding: 10px 0;
}

#content .centre-col .in-focus {
	width: auto;
}

.style1 {
	color: #FF0000;
	font-weight: bold;
}
