      <div id="mainContent">
        <div id="contentArea">
          <div class="content-header">
            <div>
              <h2>Business application down for maintenance</h2>
            </div>
          </div>
          <div>
            <p><span class="centre-col"> The business application you are trying to access is currently offline.    This may be as a result of a planned downtime for maintenance. <br />
              <br />
              For technical support, please visit the <a href="https://servicedesk.ema.europa.eu/" target="_blank">EMA Service Desk</a> portal using your user credentials for a system hosted by EMA (except   EudraVigilance). If you do not have an account or have forgotten your   credentials, please click <a href="https://register.ema.europa.eu/identityiq/login.jsf">here</a></span></p>
            <p>&nbsp;</p>
            <p>&nbsp;</p>
            <p>&nbsp;</p>
            <p>For EudraVigilance access, please use your  EudraVigilance access credentials.</p>
            <p></p>
            <p><a href="https://register.ema.europa.eu/identityiq/login.jsf"></a></p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!--  Include the footer-->
  <div id="footer-wrap">
  <div id="footer"><p class="queries" sizcache="30" sizset="110">&nbsp;</p></div></div>
